STL_FILE $STL_FILE;

MCONVERT $MCONVERT;

MINX $MINX;
MAXX $MAXX;
MINY $MINY;
MAXY $MAXY;
MINZ $MINZ;
MAXZ $MAXZ;

GRADE
{
    X { N $NX; S $GX; }
    Y { N $NY; S $GY; }
    Z { N $NZ; S $GZ; }
}

SUBGRADE
{
    X { N $SNX; S 1; }
    Y { N $SNY; S 1; }
    Z { N $SNZ; S 1; }
}
